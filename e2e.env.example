# scripts/start-winappdriver.ps1 をホストで起動したあと、これをコピーして
# 値を埋め、e2e.env として使う。
#
#   Copy-Item e2e.env.example e2e.env
#   docker compose --env-file e2e.env run --rm e2e
#
# 3つとも Docker から見えるホスト側の絶対パス・値であること。

# コンテナから WinAppDriver に届くホスト名。Docker Desktop（Windows）はこのままでよい。
WINAPPDRIVER_HOST=host.docker.internal

# ホスト（Windows）から見た e2e-workspace の絶対パス。
# hataclip-gui.exe の --test-dir / --test-dump-state に渡す先。
# 例: E2E_HOST_ROOT=C:\Users\you\source\repos\hataclip-tauri\e2e-workspace
E2E_HOST_ROOT=

# debug（target\debug）は Vite の localhost:1420 を開くので使わない。
# `scripts/build-windows.ps1` の成果物:
# HATACLIP_GUI=C:\Users\you\source\repos\hataclip-tauri\dist\windows\hataclip-gui.exe
HATACLIP_GUI=

# 省略可。無ければ HATACLIP_GUI と同じフォルダの hataclip.exe。
# HATACLIP=C:\Users\you\source\repos\hataclip-tauri\dist\windows\hataclip.exe
